# Create .gitignore in your project root
cat > .gitignore << 'EOF'
# Dependencies
node_modules/
/.pnp
.pnp.js
yarn.lock

# Build outputs
dist/
dist-ssr/
*.local

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# Database
*.sqlite
*.db

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# Project specific
server/static/*.jpg
server/static/*.png
server/static/*.jpeg
server/static/*.JPG
!.gitkeep

# Ignore personal folders (these paths are correct for your structure)
../../../Desktop/
../../../Documents/
../../../Downloads/
../../../Pictures/
../../../Music/
../../../Videos/
EOF

# Add the new .gitignore
git add .gitignore
git commit -m "Update .gitignore - include package-lock.json"